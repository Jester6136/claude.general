#!/usr/bin/env bash
# pre-push — kỷ luật, KHÔNG phải cưỡng chế. Bỏ qua được bằng `git push --no-verify`.
# Cài: chạy scripts/install-hooks.sh (git KHÔNG version .git/hooks — mỗi người clone phải tự cài).
#
# LOCAL-FIRST (GitHub giới hạn Actions — CI là [OPT]): hook này là lưới máy CHÍNH trước khi code rời máy.
# Chạy tầng TĨNH (syntax+boundary+lint) + NGHIỆM THU TẤT ĐỊNH (acceptance/*.sh — tầng A, không hạ tầng
# sống, phải nhanh). KHÔNG chạy smoke/test đầy đủ: push chậm ⇒ người ta --no-verify cho xong, cổng mất tác
# dụng (GIT-FLOW.md §11b). Đơn vị nghiệm thu chậm tới mức làm push ì = dấu hiệu nó chạm tầng B, tách ra.
# Bỏ qua được ⇒ post-merge.sh CHẠY LẠI nghiệm thu trên commit merge (lưới thứ hai, không bỏ qua được).
set -euo pipefail
echo "── pre-push: cổng tĩnh + nghiệm thu tất định (bỏ qua: git push --no-verify) ──"
repo_root="$(git rev-parse --show-toplevel)"
"$repo_root/scripts/check.sh" --naming
"$repo_root/scripts/check.sh" --syntax
"$repo_root/scripts/check.sh" --boundary
"$repo_root/scripts/check.sh" --lint
# Nghiệm thu theo ĐÚNG ref đang push (stdin: <local ref> <local sha> <remote ref> <remote sha>), không theo
# nhánh đang đứng: `git push origin agent/43-x` khi đang ở agent/42-y phải đòi đơn vị của #43, không phải #42.
# Giới hạn: đơn vị chạy trên working tree hiện tại (hook không checkout ref được push).
ids=""
while read -r local_ref _ _ _; do
  n="$(sed -nE 's#^refs/heads/agent/([0-9]+)-.*#\1#p' <<<"$local_ref")"
  [ -z "$n" ] || ids="$ids $n"
done
if [ -n "$ids" ]; then
  ACCEPTANCE_REQUIRED_IDS="$ids" "$repo_root/scripts/check.sh" --acceptance
else
  PR_BODY="" "$repo_root/scripts/check.sh" --acceptance   # không push nhánh agent/* ⇒ không đòi Issue nào, chỉ chạy các đơn vị
fi
