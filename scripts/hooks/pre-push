#!/usr/bin/env bash
# pre-push — kỷ luật, KHÔNG phải cưỡng chế. Bỏ qua được bằng `git push --no-verify`.
# Cài: chạy scripts/install-hooks.sh (git KHÔNG version .git/hooks — mỗi người clone phải tự cài).
#
# LOCAL-FIRST (GitHub giới hạn Actions — CI là [OPT]): hook này là lưới máy CHÍNH trước khi code rời máy.
# Chạy tầng TĨNH (syntax+boundary+lint) + NGHIỆM THU TẤT ĐỊNH (acceptance/*.sh — tầng A, không hạ tầng
# sống, phải nhanh). KHÔNG chạy smoke/test đầy đủ: push chậm ⇒ người ta --no-verify cho xong, cổng mất tác
# dụng (GIT-FLOW.md §11b). Đơn vị nghiệm thu chậm tới mức làm push ì = dấu hiệu nó chạm tầng B, tách ra.
# Bỏ qua được ⇒ post-merge.sh CHẠY LẠI nghiệm thu trên commit merge (lưới thứ hai, không bỏ qua được).
set -euo pipefail
echo "── pre-push: cổng tĩnh + nghiệm thu tất định (bỏ qua: git push --no-verify) ──"
repo_root="$(git rev-parse --show-toplevel)"
# Đọc danh sách ref git đưa qua stdin NGAY ĐẦU (<local ref> <local sha> <remote ref> <remote sha>) — các cổng
# bên dưới thừa hưởng stdin, một lệnh đọc stdin (vd `docker compose exec` không -T) sẽ nuốt mất danh sách.
refs="$(cat)"
"$repo_root/scripts/check.sh" --naming </dev/null
"$repo_root/scripts/check.sh" --syntax </dev/null
"$repo_root/scripts/check.sh" --boundary </dev/null
"$repo_root/scripts/check.sh" --lint </dev/null
# Theo ĐÚNG ref đang push, không theo nhánh đang đứng. Lấy tên ở phía REMOTE (thứ sẽ thành nhánh PR):
# `git push origin wip:agent/43-x` phải đòi đơn vị #43 và tên nhánh phải ASCII (AGENT.md §9) dù local là `wip`.
# Giới hạn: đơn vị chạy trên working tree hiện tại (hook không checkout ref được push).
ids=""; bad=""
while read -r local_ref _ remote_ref _; do
  [ -n "$local_ref" ] || continue
  [ "$local_ref" != "(delete)" ] || continue   # xoá nhánh từ xa — không có gì để kiểm
  name="${remote_ref:-$local_ref}"
  ! LC_ALL=C grep -q '[^ -~]' <<<"$name" || bad="$bad $name"
  n="$(sed -nE 's#^refs/heads/agent/([0-9]+)-.*#\1#p' <<<"$name")"
  [ -n "$n" ] || n="$(sed -nE 's#^refs/heads/agent/([0-9]+)-.*#\1#p' <<<"$local_ref")"
  [ -z "$n" ] || ids="$ids $n"
done <<<"$refs"
[ -z "$bad" ] || { echo "  ✗ tên nhánh đang push có ký tự ngoài ASCII:$bad — tên nhánh LUÔN tiếng Anh không dấu (AGENT.md §9)"; exit 1; }
if [ -n "$ids" ]; then
  ACCEPTANCE_REQUIRED_IDS="$ids" "$repo_root/scripts/check.sh" --acceptance </dev/null
else
  PR_BODY="" "$repo_root/scripts/check.sh" --acceptance </dev/null   # không push nhánh agent/* ⇒ không đòi Issue nào, chỉ chạy các đơn vị
fi
